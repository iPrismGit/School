<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.MessagesFragment" >

    <LinearLayout
        android:layout_alignParentTop="true"
        android:id="@+id/toolbar_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:visibility="gone"
            android:id="@+id/imageView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxWidth="24dp"
            android:maxHeight="24dp"
            android:src="@drawable/menu_img" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:text="Messages"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <ImageView
            android:visibility="gone"
            android:id="@+id/imageView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:adjustViewBounds="true"
            android:maxWidth="24dp"
            android:maxHeight="24dp"
            android:src="@drawable/search_img" />

        <ImageView
            android:id="@+id/dotsImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxWidth="40dp"
            android:maxHeight="30dp"
            android:src="@drawable/dots_img" />
    </LinearLayout>

    <ScrollView
        android:layout_below="@id/toolbar_ll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_marginTop="@dimen/_5sdp"
                android:id="@+id/select_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/all_tv"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:background="@drawable/color_bg"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=" All "
                    android:padding="@dimen/_5sdp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/inter"/>

                <TextView
                    android:id="@+id/parent_tv"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:background="@drawable/edit_text_bg"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=" Parent "
                    android:padding="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/inter"/>

                <TextView
                    android:id="@+id/staff_tv"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:background="@drawable/edit_text_bg"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=" Staff "
                    android:padding="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/inter"/>

                <TextView
                    android:id="@+id/system_tv"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:background="@drawable/edit_text_bg"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=" System "
                    android:padding="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/inter"/>


            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_100sdp"
                android:id="@+id/nodataTv"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:src="@drawable/chat"/>

                <TextView
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:text="No Messages Found "
                    android:textColor="@color/gray1"
                    android:textSize="16sp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_marginTop="@dimen/_20sdp"
                android:id="@+id/messages_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_below="@id/select_ll" />


        </LinearLayout>

    </ScrollView>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/message_btn"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:clickable="true"
        android:src="@drawable/baseline_add_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</RelativeLayout>